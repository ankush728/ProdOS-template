# ProdOS Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# SAM.gov API key (free registration at https://api.sam.gov/)
# Used by: scripts/voc_procurement_scan.py
SAM_API_KEY=

# Reddit API credentials (optional, improves rate limits for voc_reddit_scan.py)
# Register at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Identify your scanner to Reddit, e.g. voc-scanner/1.0 (by /u/your-reddit-username)
REDDIT_USER_AGENT=

# Gong API credentials (from your Gong admin: Settings > API)
# Used by: mcp-servers/gong-mcp
GONG_ACCESS_KEY=
GONG_ACCESS_SECRET=
